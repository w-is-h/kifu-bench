#!/usr/bin/env python3
"""Inspection only. Usage: python3 after.py MOVE COLOR < board.txt
Places MOVE (e.g. F5) for COLOR (X or O) on the pasted board, removes captured
enemy stones, and prints every group's libs (flags <=2). Use it on EVERY
candidate move: it shows whether my own move kills one of my groups' libs."""
import sys
C="ABCDEFGHJ"
rows=[l.split()[1:10] for l in sys.stdin if l.split() and l.split()[0].isdigit()]
b={(c,8-r):v for r,t in enumerate(rows) for c,v in enumerate(t)}
mv,col=sys.argv[1].upper(),sys.argv[2].upper()
p=(C.index(mv[0]),int(mv[1:])-1)
assert b[p]=='.', "occupied"
b[p]=col
def grp(q):
    g,l,st={q},set(),[q]
    while st:
        x,y=st.pop()
        for n in((x+1,y),(x-1,y),(x,y+1),(x,y-1)):
            if n in b:
                if b[n]=='.': l.add(n)
                elif b[n]==b[q] and n not in g: g.add(n);st.append(n)
    return g,l
opp='O' if col=='X' else 'X'
x,y=p
for n in((x+1,y),(x-1,y),(x,y+1),(x,y-1)):
    if n in b and b[n]==opp:
        g,l=grp(n)
        if not l:
            print("captures",len(g))
            for s in g: b[s]='.'
seen=set()
for q in sorted(b):
    if b[q] in 'XO' and q not in seen:
        g,l=grp(q);seen|=g
        nm=lambda s:f"{C[s[0]]}{s[1]+1}"
        print(b[q],len(g),"libs",len(l),sorted(map(nm,l)),"<-- DANGER" if len(l)<=2 else "")
