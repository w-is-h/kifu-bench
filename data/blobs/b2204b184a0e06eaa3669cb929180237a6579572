#!/usr/bin/env python3
"""Inspection only: print every group's stones and liberty count.
Usage: paste the 9 board rows (top row 9 first, as shown by board()) into stdin:
  python3 libs.py <<'EOF'
   9  .  .  X ...  9
  ...
  EOF
"""
import sys

COLS = "ABCDEFGHJ"
rows = []
for line in sys.stdin:
    toks = line.split()
    if len(toks) >= 10 and toks[0].isdigit():
        rows.append(toks[1:10])
assert len(rows) == 9, "need 9 board rows"
board = {}
for r, toks in enumerate(rows):
    for c, t in enumerate(toks):
        board[(c, 8 - r)] = t

def name(p):
    return f"{COLS[p[0]]}{p[1] + 1}"

seen = set()
for p, color in sorted(board.items()):
    if color not in "XO" or p in seen:
        continue
    group, libs, stack = [], set(), [p]
    seen.add(p)
    while stack:
        q = stack.pop()
        group.append(q)
        x, y = q
        for n in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):
            if n not in board:
                continue
            if board[n] == ".":
                libs.add(n)
            elif board[n] == color and n not in seen:
                seen.add(n)
                stack.append(n)
    flag = "  <-- DANGER" if len(libs) <= 2 else ""
    print(f"{color} size={len(group):2d} libs={len(libs)} "
          f"[{' '.join(sorted(map(name, libs)))}]{flag}  stones: "
          f"{' '.join(sorted(map(name, group)))[:60]}")
